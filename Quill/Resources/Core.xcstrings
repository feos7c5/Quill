    "There are too many development certificates. Revoke one under Certificates at Apple and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt zu viele Entwicklungszertifikate. Unter „Zertifikate bei Apple“ eines widerrufen und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a trop de certificats de développement. Révoquez-en un sous Certificats chez Apple et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados certificados de desarrollo. Revoca uno en Certificados en Apple e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono troppi certificati di sviluppo. Revocane uno in Certificati presso Apple e riprova."
