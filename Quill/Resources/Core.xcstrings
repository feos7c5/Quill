    "Saved sign-in data could not be deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Anmeldedaten konnten nicht gelöscht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de connexion enregistrées n'ont pas pu être supprimées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido eliminar los datos de inicio de sesión guardados."
          }
