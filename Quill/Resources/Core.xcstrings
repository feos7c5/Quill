        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla geliştirme sertifikası var. Apple'daki Sertifikalar bölümünden birini iptal edip yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are too many development certificates. Revoke one under Certificates at Apple and try again."
          }
        }
      }
    },
