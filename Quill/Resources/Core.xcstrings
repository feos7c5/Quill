    "No app IDs left. Free accounts get only a few new app IDs per week. Remove extensions or try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App-IDs mehr frei. Kostenlose Accounts bekommen nur wenige neue App-IDs pro Woche. Erweiterungen entfernen oder später erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus d'identifiants d'app disponibles. Les comptes gratuits n'en obtiennent que quelques-uns par semaine. Supprimez des extensions ou réessayez plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quedan ID de app. Las cuentas gratuitas solo reciben unas pocas ID nuevas por semana. Elimina extensiones o inténtalo más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun ID app disponibile. Gli account gratuiti ricevono solo pochi nuovi ID app a settimana. Rimuovi le estensioni o riprova più tardi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kimliği kalmadı. Ücretsiz hesaplar haftada yalnızca birkaç yeni uygulama kimliği alır. Uzantıları kaldırın veya daha sonra yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app IDs left. Free accounts get only a few new app IDs per week. Remove extensions or try again later."
          }
        }
      }
    },
    "No pairing file yet. Pair this iPhone first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Pairing-Datei. Bitte zuerst dieses iPhone koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier de jumelage. Jumelez d'abord cet iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay archivo de emparejamiento. Empareja primero este iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file di abbinamento. Abbina prima questo iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eşleme dosyası yok. Önce bu iPhone'u eşleyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pairing file yet. Pair this iPhone first."
          }
        }
      }
    },
