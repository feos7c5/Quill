{
  "sourceLanguage": "de",
  "strings": {
    "A free account allows at most three active apps. Remove an app and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Account sind höchstens drei Apps gleichzeitig aktiv. Eine App entfernen und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte gratuit permet au maximum trois apps actives. Supprimez une app et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta gratuita permite como máximo tres apps activas. Elimina una app e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un account gratuito consente al massimo tre app attive. Rimuovi un'app e riprova."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz hesapta en fazla üç uygulama etkin olabilir. Bir uygulamayı kaldırıp yeniden deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free account allows at most three active apps. Remove an app and try again."
          }
        }
      }
    },
    "Apple reported an error.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat einen Fehler gemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a signalé une erreur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha informado de un error."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha segnalato un errore."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bir hata bildirdi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple reported an error."
          }
        }
      }
    },
    "Choose a team first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte zuerst ein Team wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d'abord une équipe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige primero un equipo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli prima un team."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir ekip seçin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a team first."
          }
        }
      }
    },
    "Connecting to the iPhone…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde mit dem iPhone …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à l'iPhone…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con el iPhone…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione all'iPhone…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'a bağlanılıyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to the iPhone…"
          }
        }
      }
    },
    "Developer Mode is off. Turn it on in Settings → Privacy & Security → Developer Mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwicklermodus ist aus. Einstellungen → Datenschutz & Sicherheit → Entwicklermodus einschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode développeur est désactivé. Activez-le dans Réglages → Confidentialité et sécurité → Mode développeur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de desarrollador está desactivado. Actívalo en Ajustes → Privacidad y seguridad → Modo de desarrollador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità sviluppatore è disattivata. Attivala in Impostazioni → Privacy e sicurezza → Modalità sviluppatore."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici Modu kapalı. Ayarlar → Gizlilik ve Güvenlik → Geliştirici Modu'ndan açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode is off. Turn it on in Settings → Privacy & Security → Developer Mode."
          }
        }
      }
    },
    "Enter this code in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Code in den Einstellungen eingeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce code dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce este código en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci questo codice in Impostazioni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu Ayarlar'a girin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this code in Settings."
          }
        }
      }
    },
