          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar LiveContainer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura LiveContainer"
          }
        },
        "tr": {
