    "Nur nötig, wenn Quill nicht gekoppelt ist: Installation über itms-services mit eigenem HTTPS-Zertifikat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only needed if Quill isn't paired: installation via itms-services with your own HTTPS certificate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement si Quill n'est pas jumelé : installation via itms-services avec votre propre certificat HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es necesario si Quill no está emparejado: instalación mediante itms-services con tu propio certificado HTTPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo se Quill non è abbinato: installazione tramite itms-services con un certificato HTTPS proprio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Quill eşlenmemişse gerekir: kendi HTTPS sertifikanızla itms-services üzerinden yükleme."
          }
        }
      }
    },
    "Nächster Ablauf": {
      "localizations": {
