            "state": "translated",
            "value": "LiveContainer'ı ayarla"
          }
        }
      }
    },
    "LiveContainer startet Apps in einer Art Container. So zählt nur LiveContainer selbst zu den drei Apps eines kostenlosen Accounts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer runs apps inside a kind of container, so only LiveContainer itself counts toward a free account's three apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer exécute les apps dans une sorte de conteneur ; seul LiveContainer compte parmi les trois apps d'un compte gratuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer ejecuta apps dentro de una especie de contenedor, así solo LiveContainer cuenta entre las tres apps de una cuenta gratuita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer esegue le app in una sorta di contenitore, così solo LiveContainer conta tra le tre app di un account gratuito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer uygulamaları bir tür kapsayıcıda çalıştırır; böylece ücretsiz hesabın üç uygulamasına yalnızca LiveContainer sayılır."
          }
        }
      }
    },
    "LiveContainer startet beliebig viele Apps in einer einzigen installierten App.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer runs any number of apps inside a single installed app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer exécute autant d'apps que vous voulez dans une seule app installée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer ejecuta cualquier número de apps dentro de una sola app instalada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer esegue un numero qualsiasi di app in un'unica app installata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiveContainer, tek bir yüklü uygulama içinde istediğiniz kadar uygulama çalıştırır."
          }
        }
      }
    },
