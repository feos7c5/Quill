    "Wer diese Datei und ihr Passwort hat, kann in deinem Namen signieren. Nur an sichere Orte speichern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this file and its password can sign in your name. Only save it somewhere safe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque possède ce fichier et son mot de passe peut signer en votre nom. Enregistrez-le uniquement en lieu sûr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tenga este archivo y su contraseña puede firmar en tu nombre. Guárdalo solo en un lugar seguro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi ha questo file e la sua password può firmare a tuo nome. Salvalo solo in un luogo sicuro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyaya ve parolasına sahip olan herkes sizin adınıza imzalayabilir. Yalnızca güvenli bir yere kaydedin."
          }
        }
      }
    },
