    "Das ist eine Lockdown-Pairing-Datei. Ab iOS 27 nutzt Quill nur Remote Pairing; bitte „Koppeln ohne Computer“ verwenden oder eine Remote-Pairing-Datei wählen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a lockdown pairing file. On iOS 27 Quill uses Remote Pairing only; use “Pair Without a Computer” or choose a Remote Pairing file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit d'un fichier de jumelage lockdown. Sous iOS 27, Quill utilise uniquement Remote Pairing ; utilisez « Jumeler sans ordinateur » ou choisissez un fichier Remote Pairing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un archivo de emparejamiento lockdown. En iOS 27, Quill solo usa Remote Pairing; usa «Emparejar sin ordenador» o elige un archivo de Remote Pairing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un file di abbinamento lockdown. Su iOS 27 Quill usa solo Remote Pairing; usa «Abbina senza computer» o scegli un file Remote Pairing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir lockdown eşleme dosyası. iOS 27'de Quill yalnızca Remote Pairing kullanır; “Bilgisayarsız Eşle”yi kullanın veya bir Remote Pairing dosyası seçin."
          }
        }
      }
    },
