    "Temporäres Profil: Liest einmalig die UDID dieses iPhones und gibt sie an Quill auf diesem Gerät. Es wird nichts dauerhaft installiert und nichts ins Internet gesendet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary profile: reads this iPhone's UDID once and passes it to Quill on this device. Nothing is installed permanently and nothing is sent to the internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil temporaire : lit une fois l'UDID de cet iPhone et le transmet à Quill sur cet appareil. Rien n'est installé durablement ni envoyé sur Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil temporal: lee una vez el UDID de este iPhone y lo pasa a Quill en este dispositivo. No se instala nada de forma permanente ni se envía nada a internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo temporaneo: legge una volta l'UDID di questo iPhone e lo passa a Quill su questo dispositivo. Non viene installato nulla in modo permanente né inviato nulla su internet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici profil: bu iPhone'un UDID'sini bir kez okur ve bu cihazdaki Quill'e verir. Kalıcı bir şey yüklenmez, internete hiçbir şey gönderilmez."
          }
        }
      }
    },
