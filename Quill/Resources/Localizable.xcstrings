    "Kein Zertifikat vorhanden. Im Tab „Signieren“ mit der Apple-ID anmelden oder ein .p12 mit Profil importieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No certificate. Sign in with your Apple ID in the “Sign” tab or import a .p12 with a profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun certificat. Connectez-vous avec votre identifiant Apple dans l'onglet « Signer » ou importez un .p12 avec un profil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay certificado. Inicia sesión con tu Apple ID en la pestaña «Firmar» o importa un .p12 con perfil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun certificato. Accedi con l'Apple ID nella scheda «Firma» o importa un .p12 con profilo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika yok. “İmzala” sekmesinde Apple Kimliğinizle oturum açın veya profilli bir .p12 içe aktarın."
          }
        }
      }
    },
    "Kein Zertifikat vorhanden. Mit der Apple-ID anmelden oder ein .p12 mit Profil importieren.": {
      "localizations": {
