    "Kein gültiges Profil für „%@“ und dieses iPhone. Profil importieren oder Bundle-ID anpassen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid profile for “%@” and this iPhone. Import a profile or adjust the bundle ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil valide pour « %@ » et cet iPhone. Importez un profil ou ajustez le bundle ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay perfil válido para «%@» y este iPhone. Importa un perfil o ajusta la ID de paquete."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun profilo valido per «%@» e questo iPhone. Importa un profilo o modifica il bundle ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ve bu iPhone için geçerli profil yok. Bir profil içe aktarın veya paket kimliğini ayarlayın."
          }
        }
      }
    },
    "Kein gültiges Profil für „%@“ zu diesem Zertifikat gefunden. Passendes .mobileprovision importieren oder die Bundle-ID anpassen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid profile found for “%@” with this certificate. Import a matching .mobileprovision or adjust the bundle ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil valide trouvé pour « %@ » avec ce certificat. Importez un .mobileprovision correspondant ou ajustez le bundle ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado un perfil válido para «%@» con este certificado. Importa un .mobileprovision adecuado o ajusta la ID de paquete."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun profilo valido trovato per «%@» con questo certificato. Importa un .mobileprovision corrispondente o modifica il bundle ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sertifikayla “%@” için geçerli profil bulunamadı. Uygun bir .mobileprovision içe aktarın veya paket kimliğini ayarlayın."
          }
        }
      }
    },
