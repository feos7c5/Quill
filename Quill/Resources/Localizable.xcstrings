    "Import von .p12, .mobileprovision, .cer oder .zip, etwa von einem UDID-Registrierungsdienst. Eine Apple-Anmeldung ist dafür nicht nötig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a .p12, .mobileprovision, .cer or .zip, e.g. from a UDID registration service. No Apple sign-in is needed for this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un .p12, .mobileprovision, .cer ou .zip, p. ex. d'un service d'enregistrement d'UDID. Aucune connexion Apple n'est requise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un .p12, .mobileprovision, .cer o .zip, p. ej. de un servicio de registro de UDID. No hace falta iniciar sesión en Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un .p12, .mobileprovision, .cer o .zip, ad es. da un servizio di registrazione UDID. Non serve l'accesso Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ör. bir UDID kayıt hizmetinden .p12, .mobileprovision, .cer veya .zip içe aktarın. Bunun için Apple oturumu gerekmez."
          }
        }
      }
    },
