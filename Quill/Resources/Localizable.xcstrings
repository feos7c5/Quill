      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources are JSON addresses in AltStore source format. Only add sources whose apps you're allowed to use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources sont des adresses JSON au format de source AltStore. N'ajoutez que des sources dont vous avez le droit d'utiliser les apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes son direcciones JSON en formato de fuente de AltStore. Añade solo fuentes cuyas apps puedas usar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sorgenti sono indirizzi JSON nel formato AltStore. Aggiungi solo sorgenti di cui puoi usare le app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynaklar AltStore kaynak biçiminde JSON adresleridir. Yalnızca uygulamalarını kullanma hakkınız olan kaynakları ekleyin."
          }
        }
      }
    },
    "Quill": {
      "shouldTranslate": false
    },
    "Quill erstellt Zertifikat und Profil automatisch. Kostenlose Apple-ID: 7 Tage Laufzeit, höchstens drei Apps. Bezahlter Account: ein Jahr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill creates the certificate and profile automatically. Free Apple ID: 7 days, at most three apps. Paid account: one year."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill crée automatiquement le certificat et le profil. Identifiant Apple gratuit : 7 jours, trois apps au maximum. Compte payant : un an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill crea automáticamente el certificado y el perfil. Apple ID gratuito: 7 días, tres apps como máximo. Cuenta de pago: un año."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill crea automaticamente certificato e profilo. Apple ID gratuito: 7 giorni, al massimo tre app. Account a pagamento: un anno."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill sertifikayı ve profili otomatik oluşturur. Ücretsiz Apple Kimliği: 7 gün, en fazla üç uygulama. Ücretli hesap: bir yıl."
          }
        }
      }
    },
    "Quill erzeugt einen privaten RSA-2048-Schlüssel, der im Schlüsselbund dieses iPhones bleibt, und eine CSR-Datei für Apple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill generates a private RSA-2048 key that stays in this iPhone's keychain, and a CSR file for Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill génère une clé privée RSA-2048 qui reste dans le trousseau de cet iPhone, ainsi qu'un fichier CSR pour Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill genera una clave privada RSA-2048 que se queda en el llavero de este iPhone y un archivo CSR para Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill genera una chiave privata RSA-2048 che resta nel portachiavi di questo iPhone e un file CSR per Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill, bu iPhone'un anahtar zincirinde kalan bir RSA-2048 özel anahtarı ve Apple için bir CSR dosyası oluşturur."
          }
        }
      }
    },
    "Quill folgt der Sprache des iPhones. Eine eigene Sprache nur für Quill lässt sich in den iOS-Einstellungen unter Quill → Sprache wählen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill follows the iPhone's language. To use a different language just for Quill, choose it in iOS Settings under Quill → Language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill suit la langue de l'iPhone. Pour une langue propre à Quill, choisissez-la dans les Réglages d'iOS sous Quill → Langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill sigue el idioma del iPhone. Para usar otro idioma solo en Quill, elígelo en Ajustes de iOS, en Quill → Idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill segue la lingua dell'iPhone. Per una lingua diversa solo per Quill, sceglila nelle Impostazioni di iOS in Quill → Lingua."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill, iPhone'un dilini kullanır. Yalnızca Quill için başka bir dil seçmek isterseniz iOS Ayarlar'da Quill → Dil bölümünden seçin."
          }
        }
      }
    },
    "Quill gekoppelt, LocalDevVPN installiert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill paired, LocalDevVPN installed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill jumelé, LocalDevVPN installé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill emparejado, LocalDevVPN instalado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill abbinato, LocalDevVPN installato"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill eşlendi, LocalDevVPN yüklü"
          }
        }
      }
    },
    "Quill hat keinen Zugriff auf das lokale Netzwerk. Unter Einstellungen → Apps → Quill „Lokales Netzwerk“ einschalten und erneut koppeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill has no access to the local network. Turn on “Local Network” under Settings → Apps → Quill and pair again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill n'a pas accès au réseau local. Activez « Réseau local » dans Réglages → Apps → Quill et jumelez à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill no tiene acceso a la red local. Activa «Red local» en Ajustes → Apps → Quill y vuelve a emparejar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill non ha accesso alla rete locale. Attiva «Rete locale» in Impostazioni → App → Quill e abbina di nuovo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill'in yerel ağa erişimi yok. Ayarlar → Uygulamalar → Quill altında “Yerel Ağ”ı açın ve yeniden eşleyin."
          }
        }
      }
    },
    "Quill ist bereit zur Kopplung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill is ready to pair"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill est prêt pour le jumelage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill está listo para emparejar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill è pronto per l'abbinamento"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill eşlemeye hazır"
          }
        }
      }
    },
    "Quill ist bereits gekoppelt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill is already paired."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill est déjà jumelé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill ya está emparejado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill è già abbinato."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill zaten eşlenmiş."
          }
        }
      }
    },
    "Quill ist noch nicht gekoppelt. Unter „Koppeln ohne Computer“ koppeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill isn't paired yet. Pair it under “Pair Without a Computer”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill n'est pas encore jumelé. Jumelez-le via « Jumeler sans ordinateur »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill aún no está emparejado. Emparéjalo en «Emparejar sin ordenador»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill non è ancora abbinato. Abbinalo in «Abbina senza computer»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill henüz eşlenmedi. “Bilgisayarsız Eşle” ile eşleyin."
          }
        }
      }
    },
    "Quill kennt die UDID dieses iPhones noch nicht. Im Tab „Signieren“ unter „UDID ermitteln“ automatisch erkennen lassen oder von Hand eintragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill doesn't know this iPhone's UDID yet. Detect it automatically under “Detect UDID” in the “Sign” tab or enter it manually."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill ne connaît pas encore l'UDID de cet iPhone. Détectez-le automatiquement via « Détecter l'UDID » dans l'onglet « Signer » ou saisissez-le manuellement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill aún no conoce el UDID de este iPhone. Detéctalo automáticamente en «Detectar UDID» en la pestaña «Firmar» o introdúcelo a mano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill non conosce ancora l'UDID di questo iPhone. Rilevalo automaticamente in «Rileva UDID» nella scheda «Firma» o inseriscilo a mano."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill bu iPhone'un UDID'sini henüz bilmiyor. “İmzala” sekmesinde “UDID'yi Algıla” ile otomatik algılatın veya elle girin."
          }
        }
      }
    },
    "Quill konnte sich nicht im lokalen Netzwerk anmelden. WLAN einschalten und erneut versuchen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill could not announce itself on the local network. Turn on Wi‑Fi and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill n'a pas pu s'annoncer sur le réseau local. Activez le Wi‑Fi et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill no ha podido anunciarse en la red local. Activa el Wi‑Fi e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill non è riuscito ad annunciarsi sulla rete locale. Attiva il Wi‑Fi e riprova."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill yerel ağda kendini duyuramadı. Wi‑Fi'yi açıp yeniden deneyin."
          }
        }
      }
    },
    "Quill spricht direkt mit Apple. Zusätzlich holt es Gerätekenndaten („Anisette“) vom Server aus den Einstellungen (Standard: ani.iloader.app). Dieser Server sieht deine IP-Adresse, nicht dein Passwort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill talks directly to Apple. It also fetches device data (“anisette”) from the server set in Settings (default: ani.iloader.app). That server sees your IP address, not your password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill communique directement avec Apple. Il récupère aussi des données d'appareil (« anisette ») auprès du serveur défini dans les réglages (par défaut : ani.iloader.app). Ce serveur voit votre adresse IP, pas votre mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill se comunica directamente con Apple. Además obtiene datos del dispositivo («anisette») del servidor indicado en Ajustes (por defecto: ani.iloader.app). Ese servidor ve tu dirección IP, no tu contraseña."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill comunica direttamente con Apple. Inoltre ottiene dati del dispositivo («anisette») dal server indicato nelle impostazioni (predefinito: ani.iloader.app). Quel server vede il tuo indirizzo IP, non la password."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill doğrudan Apple ile konuşur. Ayrıca Ayarlar'da belirtilen sunucudan cihaz verileri (“anisette”) alır (varsayılan: ani.iloader.app). Bu sunucu parolanızı değil IP adresinizi görür."
          }
        }
      }
    },
