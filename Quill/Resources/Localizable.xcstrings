    "Über LocalDevVPN erreicht Quill die Gerätedienste dieses iPhones unter 10.7.0.1:49152. Nur ändern, wenn ein anderes VPN eine andere Adresse nutzt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Through LocalDevVPN, Quill reaches this iPhone's device services at 10.7.0.1:49152. Only change this if another VPN uses a different address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Via LocalDevVPN, Quill accède aux services de cet iPhone à l'adresse 10.7.0.1:49152. Ne modifiez que si un autre VPN utilise une autre adresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A través de LocalDevVPN, Quill accede a los servicios de este iPhone en 10.7.0.1:49152. Cámbialo solo si otro VPN usa otra dirección."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tramite LocalDevVPN, Quill raggiunge i servizi di questo iPhone su 10.7.0.1:49152. Modifica solo se un altro VPN usa un indirizzo diverso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill, LocalDevVPN üzerinden bu iPhone'un cihaz hizmetlerine 10.7.0.1:49152 adresinden ulaşır. Yalnızca başka bir VPN farklı adres kullanıyorsa değiştirin."
          }
        }
      }
    },
