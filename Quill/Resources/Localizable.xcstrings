    ".dylib-Dateien oder .framework-Ordner werden nach Frameworks/ kopiert, mitsigniert und beim Start geladen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".dylib files or .framework folders are copied to Frameworks/, signed along with the app and loaded at launch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers .dylib ou dossiers .framework sont copiés dans Frameworks/, signés avec l'app et chargés au lancement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos .dylib o carpetas .framework se copian en Frameworks/, se firman con la app y se cargan al iniciar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file .dylib o le cartelle .framework vengono copiati in Frameworks/, firmati insieme all'app e caricati all'avvio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".dylib dosyaları veya .framework klasörleri Frameworks/ içine kopyalanır, uygulamayla birlikte imzalanır ve açılışta yüklenir."
          }
        }
      }
    },
