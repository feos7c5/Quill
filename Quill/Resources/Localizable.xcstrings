    "Die Installation ist noch nicht eingerichtet (Einstellungen → Installation). Bis dahin lässt sich die IPA über „Teilen“ exportieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation isn't set up yet (Settings → Installation). Until then, export the IPA via “Share”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation n'est pas encore configurée (Réglages → Installation). En attendant, exportez l'IPA via « Partager »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación aún no está configurada (Ajustes → Instalación). Mientras tanto, exporta la IPA con «Compartir»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
