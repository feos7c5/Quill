    "Kurzbefehle öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Shortcuts"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Raccourcis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Atajos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Comandi rapidi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler'i aç"
          }
        }
      }
    },
    "Kurzbefehle → Automation → „+“ → „Tageszeit“, z. B. 4:00 Uhr, täglich. „Sofort ausführen“ wählen und „Bei Ausführung benachrichtigen“ ausschalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts → Automation → “+” → “Time of Day”, e.g. 4:00 AM, daily. Choose “Run Immediately” and turn off “Notify When Run”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis → Automatisation → « + » → « Heure de la journée », p. ex. 4:00, chaque jour. Choisissez « Exécuter immédiatement » et désactivez « Notifier lors de l'exécution »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos → Automatización → «+» → «Hora del día», p. ej. 4:00, a diario. Elige «Ejecutar inmediatamente» y desactiva «Notificar al ejecutarse»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandi rapidi → Automazione → «+» → «Ora del giorno», ad es. 4:00, ogni giorno. Scegli «Esegui immediatamente» e disattiva «Notifica all'esecuzione»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler → Otomasyon → “+” → “Günün Saati”, ör. 04:00, her gün. “Hemen Çalıştır”ı seçin ve “Çalıştırıldığında Bildir”i kapatın."
          }
        }
      }
    },
