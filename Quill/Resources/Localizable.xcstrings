    "tokio, rustls, ring, reqwest, serde, rsa, rcgen, x509-cert, p12-keystore u. a. unter MIT- bzw. Apache-2.0-Lizenz. Vollständige Liste: QuillCore/Cargo.lock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tokio, rustls, ring, reqwest, serde, rsa, rcgen, x509-cert, p12-keystore and others under MIT or Apache 2.0 licenses. Full list: QuillCore/Cargo.lock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tokio, rustls, ring, reqwest, serde, rsa, rcgen, x509-cert, p12-keystore et d'autres sous licence MIT ou Apache 2.0. Liste complète : QuillCore/Cargo.lock."
          }
        },
        "es": {
