            "state": "translated",
            "value": "Desconecta LocalDevVPN y toca «Iniciar emparejamiento»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnetti LocalDevVPN, poi tocca «Avvia abbinamento»."
          }
        },
