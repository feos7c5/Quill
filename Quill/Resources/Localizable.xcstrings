    "LocalDevVPN ist verbunden. Für die Erkennung in LocalDevVPN trennen und danach wieder verbinden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN is connected. Disconnect it in LocalDevVPN for detection and reconnect afterwards."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN est connecté. Déconnectez-le dans LocalDevVPN pour la détection, puis reconnectez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN está conectado. Desconéctalo en LocalDevVPN para la detección y vuelve a conectarlo después."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN è connesso. Disconnettilo in LocalDevVPN per il rilevamento e riconnettilo dopo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN bağlı. Algılama için LocalDevVPN'de bağlantıyı kesin ve sonra yeniden bağlayın."
          }
        }
      }
    },
    "LocalDevVPN ist verbunden. Für die Kopplung in LocalDevVPN trennen und danach wieder verbinden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN is connected. Disconnect it in LocalDevVPN for pairing and reconnect afterwards."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN est connecté. Déconnectez-le dans LocalDevVPN pour le jumelage, puis reconnectez-le ensuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN está conectado. Desconéctalo en LocalDevVPN para emparejar y vuelve a conectarlo después."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN è connesso. Disconnettilo in LocalDevVPN per l'abbinamento e riconnettilo dopo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN bağlı. Eşleme için LocalDevVPN'de bağlantıyı kesin ve sonra yeniden bağlayın."
          }
        }
      }
    },
    "LocalDevVPN ist verbunden. Zuerst in LocalDevVPN trennen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
