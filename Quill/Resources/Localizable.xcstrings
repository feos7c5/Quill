    "2. „Pair with Quill“ tippen › Gerätecode des iPhones eingeben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tap “Pair with Quill” › enter your iPhone passcode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Touchez « Pair with Quill » › saisissez le code de l'iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Toca «Pair with Quill» › introduce el código del iPhone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tocca «Pair with Quill» › inserisci il codice dell'iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. “Pair with Quill”e dokunun › iPhone parolanızı girin"
          }
        }
      }
    },
