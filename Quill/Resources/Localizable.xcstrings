          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN bağlı. Önce LocalDevVPN'de bağlantıyı kesin."
          }
        }
      }
    },
    "LocalDevVPN trennen, dann „Kopplung starten“ tippen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect LocalDevVPN, then tap “Start Pairing”."
          }
        },
        "fr": {
