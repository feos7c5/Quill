          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme henüz ayarlanmadı (Ayarlar → Yükleme). O zamana kadar IPA'yı “Paylaş” ile dışa aktarın."
          }
        }
      }
    },
    "Die Kopplung braucht den Entwicklermodus und die App LocalDevVPN. Danach installiert Quill Apps direkt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing needs Developer Mode and the LocalDevVPN app. After that, Quill installs apps directly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jumelage nécessite le mode développeur et l'app LocalDevVPN. Ensuite, Quill installe les apps directement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El emparejamiento necesita el modo de desarrollador y la app LocalDevVPN. Después, Quill instala apps directamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbinamento richiede la modalità sviluppatore e l'app LocalDevVPN. Dopo, Quill installa le app direttamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleme için Geliştirici Modu ve LocalDevVPN uygulaması gerekir. Ardından Quill uygulamaları doğrudan yükler."
          }
        }
      }
