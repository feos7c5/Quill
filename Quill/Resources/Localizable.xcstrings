    "Signiert von Quill installierte Apps neu und installiert sie als Upgrade. Die Daten bleiben erhalten. Braucht eine Verbindung über LocalDevVPN.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-signs apps installed by Quill and installs them as an upgrade. Data is kept. Needs a connection via LocalDevVPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resigne les apps installées par Quill et les installe comme mise à jour. Les données sont conservées. Nécessite une connexion via LocalDevVPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a firmar las apps instaladas por Quill y las instala como actualización. Los datos se conservan. Requiere conexión mediante LocalDevVPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Firma di nuovo le app installate da Quill e le installa come aggiornamento. I dati restano. Richiede una connessione tramite LocalDevVPN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill ile yüklenen uygulamaları yeniden imzalar ve güncelleme olarak yükler. Veriler korunur. LocalDevVPN bağlantısı gerekir."
          }
        }
      }
    },
